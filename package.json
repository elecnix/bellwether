{
  "name": "@elecnix/bellwether",
  "version": "0.1.10",
  "description": "Give an agent in herdr tools to start child agents in other tabs, and a new turn when a child changes state.",
  "license": "MIT",
  "type": "module",
  "repository": "github:elecnix/bellwether",
  "keywords": [
    "pi-package",
    "claude-code",
    "herdr",
    "coding-agents"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "bellwether": "dist/cli.js",
    "bellwether-mcp": "dist/integrations/claude/channel.js"
  },
  "pi": {
    "extensions": [
      "./dist/integrations/pi/extension.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.build.json && node --disable-warning=ExperimentalWarning scripts/write-build.ts && chmod +x dist/cli.js dist/integrations/claude/channel.js",
    "prepare": "npm run build",
    "typecheck": "tsgo --noEmit -p .",
    "test": "npm run test:unit && npm run test:integration && npm run test:lab",
    "test:unit": "node --test --test-concurrency=${BELLWETHER_TEST_CONCURRENCY:-4} --import ./test/fixtures/isolation.ts --disable-warning=ExperimentalWarning \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=${BELLWETHER_TEST_CONCURRENCY:-4} --import ./test/fixtures/isolation.ts --disable-warning=ExperimentalWarning \"test/integration/**/*.test.ts\"",
    "test:lab": "node --disable-warning=ExperimentalWarning test/lab/scrub-environment.ts && node --test --test-concurrency=1 --import ./test/fixtures/isolation.ts --import ./test/lab/scrub-environment.ts --disable-warning=ExperimentalWarning \"test/lab/**/*.test.ts\"",
    "check:prose": "node --disable-warning=ExperimentalWarning scripts/prose.ts lint",
    "check:prose-coverage": "node --disable-warning=ExperimentalWarning scripts/prose.ts coverage",
    "check:fixtures": "node --disable-warning=ExperimentalWarning scripts/fixture-identifiers.ts",
    "doctor": "node --disable-warning=ExperimentalWarning src/cli.ts doctor",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.ts",
    "site": "node --disable-warning=ExperimentalWarning scripts/build-site.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "marked": "18.3.0"
  }
}
